{
    "name": "nexp",
    "type": "module",
    "private": true,
    "browserslist": [
        "defaults"
    ],
    "scripts": {
        "build": "drizzle-kit push && nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint:es": "eslint .",
        "lint:es:fix": "eslint . --fix",
        "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
        "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "@nuxt/eslint": "^1.17.0",
        "@nuxtjs/stylelint-module": "^5.2.1",
        "bcrypt-ts": "^9.0.2",
        "drizzle-orm": "^0.45.2",
        "eslint": "^10.11.0",
        "jsonwebtoken": "^9.0.3",
        "nuxt": "^4.6.1",
        "stylelint": "^17.15.0",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0",
        "zod": "^4.6.1"
    },
    "devDependencies": {
        "@nuxt/test-utils": "^4.3.3",
        "@types/jsonwebtoken": "^9.0.10",
        "drizzle-kit": "^0.31.10",
        "postcss-html": "^2.0.0",
        "sass": "^1.102.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vitest": "^5.0.3"
    },
    "allowScripts": {
        "esbuild": true,
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
